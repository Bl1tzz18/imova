<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Needed for ASP.NET Core Identity types (UserManager<>, IUserStore<>, …) used directly by
         the Auth unit tests' fake UserManager setup — same reason Application/Infrastructure need it. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\backend\Imova.Domain\Imova.Domain.csproj" />
    <ProjectReference Include="..\..\src\backend\Imova.Application\Imova.Application.csproj" />
    <ProjectReference Include="..\..\src\backend\Imova.Infrastructure\Imova.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\backend\Imova.Api\Imova.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <!-- Backs a real ImovaDbContext for handler tests, since IApplicationDbContext exposes plain
         EF Core DbSet<T> (not a repository interface) — no database needed, no schema/PostGIS
         validation happens against InMemory, so it's a faithful-enough stand-in for testing
         handler logic (as opposed to Npgsql-specific SQL, which only the real Postgres in
         Imova.IntegrationTests can exercise). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
