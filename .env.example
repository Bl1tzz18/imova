# Copy this file to .env and fill in real values. .env is gitignored and must never be committed.

# Google OAuth client used for "Sign in with Google" — create one at
# https://console.cloud.google.com/apis/credentials (Web application, with
# http://localhost:3000 as an authorized JavaScript origin).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Symmetric key used to sign/validate JWTs (HS256). Generate a random one, e.g.:
#   openssl rand -base64 64
JWT_SIGNING_KEY=replace-with-a-long-random-base64-string

# Local Postgres credentials used by docker-compose (throwaway dev values are fine).
POSTGRES_USER=imova
POSTGRES_PASSWORD=replace-with-a-dev-password
